<section class="container" style="text-align: center; padding: 8rem 2rem 6rem;">
  <div class="fade-in">
    <h1 style="font-size: 4rem; margin-bottom: 2rem; letter-spacing: -0.02em;">
      Elevate Your University <br />
      <span
        style="background: linear-gradient(135deg, var(--primary), var(--secondary)); -webkit-background-clip: text; background-clip: text; color: transparent;">Knowledge
        Experience</span>
    </h1>
    <p style="font-size: 1.4rem; color: var(--text-light); max-width: 700px; margin: 0 auto 3rem;">
      The intelligent RAG assistant designed for ASTU students and faculty. Get precise answers from official documents
      in seconds.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center;">
      <button id="start-chat-btn" class="btn btn-primary" style="padding: 16px 42px; font-size: 1.1rem;">
        Get Started <i class="fas fa-arrow-right" style="margin-left: 8px;"></i>
      </button>
    </div>
  </div>
</section>

<!-- Chat Widget -->
<div id="chat-widget">
  <div id="chat-trigger"><i class="fas fa-comment-dots"></i></div>
  <div id="chat-window" class="hidden">
    <!-- Sidebar -->
    <div id="chat-sidebar">
      <div id="chat-sidebar-header">
        <span>History</span>
        <button id="new-chat-btn" title="New Chat"
          style="background: none; border: none; cursor: pointer; color: var(--primary);">
          <i class="fas fa-plus-circle fa-lg"></i>
        </button>
      </div>
      <div id="chat-history-list">
        <!-- History items will be injected here -->
      </div>
    </div>

    <!-- Main Chat Area -->
    <div id="chat-main">
      <div class="chat-header">
        <div>
          <p style="font-weight: bold; margin: 0;">ASTU Bot</p>
          <small style="opacity: 0.9;">Gemini 2.5 Flash</small>
        </div>
        <i class="fas fa-times" id="close-chat" style="cursor: pointer;"></i>
      </div>

      <div id="chat-body">
        <div class="msg ai">
          Hello! 👋 I'm your AI assistant. I can answer questions about our website, services, and uploaded documents.
          How can I help you today?
        </div>
      </div>

      <!-- Typing Indicator -->
      <div id="typing-indicator" class="hidden typing-indicator-wrapper">
        <div class="typing">
          <div class="dot"></div>
          <div class="dot"></div>
          <div class="dot"></div>
        </div>
      </div>

      <form id="chat-form" class="chat-form">
        <input type="text" id="chat-input" class="chat-input" placeholder="Type your message..." autocomplete="off" />
        <button type="submit" class="chat-send-btn">
          <i class="fas fa-paper-plane"></i>
        </button>
      </form>
    </div>
  </div>
</div>

<script src="/js/chat.js"></script>

<script src="/js/chat.js"></script>