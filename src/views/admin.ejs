<div class="container">
  <div style="display: flex; justify-content: space-between; align-items: center;">
    <h1>Admin Dashboard</h1>
    <div id="status" style="font-weight: 600;"></div>
  </div>

  <div class="dashboard-grid">
    <!-- Knowledge Base Card -->
    <div class="card">
      <h2 style="display: flex; align-items: center; gap: 10px; margin-bottom: 1.5rem;">
        <i class="fas fa-file-pdf" style="color: var(--secondary)"></i> Document Upload
      </h2>
      <p style="color: #6b7280; margin-bottom: 1.5rem;">
        Upload PDF files to train the chatbot.
      </p>

      <div id="drop-zone" class="upload-card">
        <i class="fas fa-cloud-upload-alt" style="font-size: 2.5rem; color: var(--primary); margin-bottom: 1rem;"></i>
        <p style="font-weight: 500;">Click or Drag & Drop PDF</p>
        <small style="color: #9ca3af;">Supported: PDF</small>
        <input type="file" id="file-input" hidden accept="application/pdf" />
        <div id="file-name" style="margin-top: 10px; font-weight: 600; color: var(--primary);"></div>
      </div>

      <button id="upload-btn" class="btn btn-primary" style="width: 100%;">
        <i class="fas fa-rocket"></i> Process & Index
      </button>
    </div>

    <!-- Quick Text Card -->
    <div class="card">
      <h2 style="display: flex; align-items: center; gap: 10px; margin-bottom: 1.5rem;">
        <i class="fas fa-pen-nib" style="color: var(--secondary)"></i> Manual Entry
      </h2>
      <p style="color: #6b7280; margin-bottom: 1.5rem;">
        Add specific knowledge directly.
      </p>

      <textarea id="raw-text" placeholder="Enter text content here..."
        style="width: 100%; height: 200px; padding: 15px; border: 1px solid #d1d5db; border-radius: 8px; margin-bottom: 1.5rem; font-family: inherit; resize: vertical;"></textarea>

      <button id="text-btn" class="btn btn-primary" style="width: 100%;">
        <i class="fas fa-save"></i> Save to Database
      </button>
    </div>
  </div>
</div>
<script src="/js/admin.js"></script>